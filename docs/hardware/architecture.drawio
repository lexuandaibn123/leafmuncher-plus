        <mxCell id="w_gnd" value="mát chung" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#666666;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="j_gnd" target="k_gnd">
