<mxfile host="app.diagrams.net" agent="leafmuncher-plus" version="24.0.0">
  <diagram id="hw-arch" name="Dau noi phan cung">
    <mxGraphModel dx="1000" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Sơ đồ đấu nối phần cứng — LeafMuncher+ (STM32F429I-DISC1)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=17;" vertex="1" parent="1">
