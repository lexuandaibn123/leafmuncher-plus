        <mxCell id="board_lbl" value="KIT STM32F429I-DISC1&#10;(vi điều khiển + SDRAM + ST-LINK trên bo)" style="text;html=1;align=center;fontStyle=1;fontSize=12;" vertex="1" parent="board">
          <mxGeometry x="20" y="10" width="240" height="34" as="geometry" />
