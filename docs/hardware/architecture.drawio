        <!-- ============ USB -> bo ============ -->
        <mxCell id="w_usb" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="usb" target="board">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ Ghi chu ============ -->
        <mxCell id="note" value="• Cấp 3V3, không cấp 5V (ADC chỉ đo 0–3.3V).&#10;• Nút SW: thả = mức 1, nhấn = mức 0 (điện trở kéo lên có sẵn trong STM32).&#10;• Nối bằng 5 dây Dupont cái–cái." style="text;html=1;align=left;verticalAlign=top;fontSize=11;spacing=4;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1">
