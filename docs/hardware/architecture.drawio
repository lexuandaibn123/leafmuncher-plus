        <!-- ============ 5 DAY NOI ============ -->
        <mxCell id="w_5v" value="nguồn 3.3V" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#d79b00;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="j_5v" target="k_3v3">
